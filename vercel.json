{
  "crons": [
    {
      "path": "/api/cron/daily-class-summary",
      "schedule": "30 9 * * 2,4,6"
    },
    {
      "path": "/api/cron/weekly-class-report",
      "schedule": "30 9 * * 1"
    },
    {
      "path": "/api/cron/monthly-report",
      "schedule": "0 1 28-31 * *"
    }
  ],
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/next"
    }
  ],
  "build": {
    "env": {
      "NEXT_TELEMETRY_DISABLED": "1"
    }
  }
}
